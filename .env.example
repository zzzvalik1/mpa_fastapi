# Application
APP_NAME=MLK_company
APP_DEBUG=true
APP_KEY=appsecretkey

# JWT
JWT_KEY=jwtsecretkey
JWT_ALGORITHM=HS256
JWT_LIFETIME=3600

# Main database (CUSTOMER / SERVICE / TARIF / FEE / FREEZING ...)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=slim4_api_skeleton
DB_USER=name
DB_PASS=pass

# Webclient logs database
DB2_HOST=127.0.0.1
DB2_PORT=3306
DB2_NAME=slim4_api_skeleton
DB2_USER=name
DB2_PASS=pass

# LK logs database
DB3_HOST=127.0.0.1
DB3_PORT=3306
DB3_NAME=slim4_api_skeleton
DB3_USER=name
DB3_PASS=pass

# Logging
LOG_NAME=logged
LOG_PUSH_NAME=push_log
LOG_LEVEL=DEBUG
LOG_DIR=storage/logs
LOG_RETENTION_DAYS=30

# Mailer HTTP gateway
MAIL_URL=https://messaging.ru/mail/api.php
MAIL_KEY=mail_key

# Push HTTP gateway
PUSH_URL=https://push.ru
PUSH_KEY=push_key

# Server
HOST=0.0.0.0
PORT=8080
